{
  "id": "./",
  "version": "3.4.0",
  "name": "מדריך הווידאו לרכיבת אדוונצ'ר / Community Adventure Riding Guide",
  "short_name": "ADV Guide",
  "description": "578 הדרכות רכיבה פעילות ומסווגות, ובהן 425 סרטונים מלאים ו־153 קצרים מאומתים, בעברית ובאנגלית.",
  "lang": "he",
  "dir": "rtl",
  "start_url": "./#home",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "theme_color": "#123d31",
  "background_color": "#f4f1e8",
  "categories": [
    "education",
    "travel",
    "sports"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./assets/screenshots/pwa-desktop.png",
      "sizes": "1600x1000",
      "type": "image/png",
      "form_factor": "wide",
      "label": "ספריית ההדרכות במחשב / Desktop guide"
    },
    {
      "src": "./assets/screenshots/pwa-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "ספריית ההדרכות בטלפון / Mobile guide"
    }
  ],
  "shortcuts": [
    {
      "name": "ספריית הסרטונים / Video library",
      "short_name": "ספרייה / Library",
      "url": "./#library"
    },
    {
      "name": "ספריית הקצרים / Shorts library",
      "short_name": "קצרים / Shorts",
      "url": "./#shorts"
    },
    {
      "name": "מסלולי הלימוד / Learning paths",
      "short_name": "מסלולים / Paths",
      "url": "./#paths"
    },
    {
      "name": "מרכז הטיולים / Trip centre",
      "short_name": "טיולים / Trips",
      "url": "./#trips"
    },
    {
      "name": "שאלו את המדריך / Ask the guide",
      "short_name": "שאלו / Ask",
      "url": "./#smart"
    }
  ]
}
