{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adventure-riding-video-guide:schema:video:3.3.0",
  "title": "Adventure Riding Video Record — bilingual v3.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "youtube_video_id",
    "youtube_url",
    "thumbnail_url",
    "title_original",
    "title_he",
    "title_en",
    "channel_name",
    "channel_url",
    "published_date",
    "duration_seconds",
    "language",
    "subtitle_languages",
    "domain",
    "primary_category",
    "secondary_categories",
    "subtopics",
    "content_type",
    "tags",
    "skill_level",
    "risk_level",
    "motorcycle_types",
    "motorcycle_weight_classes",
    "terrain_types",
    "road_conditions",
    "summary_he",
    "summary_en",
    "learning_points_he",
    "learning_points_en",
    "fit_for_he",
    "fit_for_en",
    "why_watch_he",
    "why_watch_en",
    "exercises_he",
    "exercises_en",
    "equipment_he",
    "equipment_en",
    "safety_warnings_he",
    "safety_warnings_en",
    "common_mistakes_he",
    "common_mistakes_en",
    "chapters",
    "quality_score",
    "quality_reason_he",
    "quality_reason_en",
    "source_type",
    "contains_marketing",
    "related_video_ids",
    "verification",
    "last_checked"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^yts?-[A-Za-z0-9_-]{11}$"
    },
    "youtube_video_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "youtube_url": {
      "type": "string",
      "pattern": "^https://www\\.youtube\\.com/(?:watch\\?v=|shorts/)[A-Za-z0-9_-]{11}$"
    },
    "thumbnail_url": {
      "type": "string",
      "format": "uri"
    },
    "title_original": {
      "type": "string",
      "minLength": 1
    },
    "title_he": {
      "type": "string",
      "minLength": 1
    },
    "title_en": {
      "type": "string",
      "minLength": 1
    },
    "channel_name": {
      "type": "string",
      "minLength": 1
    },
    "channel_url": {
      "type": "string",
      "format": "uri"
    },
    "published_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "duration_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "language": {
      "type": "string",
      "enum": [
        "he",
        "en"
      ]
    },
    "subtitle_languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "domain": {
      "type": "string",
      "enum": [
        "offroad_adventure",
        "road",
        "mixed",
        "practice",
        "safety_recovery",
        "touring_travel"
      ]
    },
    "primary_category": {
      "type": "string"
    },
    "secondary_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "subtopics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "content_type": {
      "type": "string",
      "enum": [
        "technique",
        "explainer",
        "drill",
        "maintenance_howto",
        "checklist",
        "touring_guide",
        "course_overview",
        "case_study"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 2
    },
    "skill_level": {
      "type": "string",
      "enum": [
        "beginner",
        "advanced_beginner",
        "intermediate",
        "advanced"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "motorcycle_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "motorcycle_weight_classes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "terrain_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "road_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "summary_he": {
      "type": "string",
      "minLength": 30
    },
    "summary_en": {
      "type": "string",
      "minLength": 30
    },
    "learning_points_he": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 8
      },
      "minItems": 3,
      "maxItems": 6
    },
    "learning_points_en": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 8
      },
      "minItems": 3,
      "maxItems": 6
    },
    "fit_for_he": {
      "type": "string",
      "minLength": 10
    },
    "fit_for_en": {
      "type": "string",
      "minLength": 10
    },
    "why_watch_he": {
      "type": "string",
      "minLength": 10
    },
    "why_watch_en": {
      "type": "string",
      "minLength": 10
    },
    "exercises_he": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "exercises_en": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "equipment_he": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "equipment_en": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "safety_warnings_he": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "safety_warnings_en": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "common_mistakes_he": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "common_mistakes_en": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_seconds",
          "end_seconds",
          "title"
        ],
        "properties": {
          "start_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "end_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "quality_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "quality_reason_he": {
      "type": "string",
      "minLength": 20
    },
    "quality_reason_en": {
      "type": "string",
      "minLength": 20
    },
    "source_type": {
      "type": "string",
      "enum": [
        "community_educator",
        "experienced_rider",
        "manufacturer",
        "official_safety_program",
        "professional_instructor",
        "riding_school",
        "training_channel"
      ]
    },
    "contains_marketing": {
      "type": "boolean"
    },
    "related_video_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_status",
        "metadata_verified",
        "content_evidence_types",
        "classification_confidence",
        "notes_he",
        "notes_en"
      ],
      "properties": {
        "link_status": {
          "enum": [
            "active_public",
            "active_public_at_research_date",
            "unavailable",
            "private",
            "unknown"
          ]
        },
        "metadata_verified": {
          "type": "boolean"
        },
        "content_evidence_types": {
          "type": "array",
          "items": {
            "enum": [
              "description",
              "chapters",
              "transcript",
              "visual_review",
              "visual_content_review",
              "captions_available",
              "youtube_search_metadata",
              "youtube_player_description"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "classification_confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "notes_he": {
          "type": "string",
          "minLength": 10
        },
        "notes_en": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "last_checked": {
      "type": "string",
      "format": "date"
    },
    "media_format": {
      "type": "string",
      "enum": ["long", "short"]
    }
  }
}
